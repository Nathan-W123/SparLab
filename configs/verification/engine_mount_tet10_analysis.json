{
  // ---------------------------------------------------------------------------
  // The engine mount of benchmark 9 meshed with quadratic tetrahedra: 13 918
  // C3D10 cells from Gmsh 4.15.2 at a 6 mm element size, their edge nodes on
  // the curved bolt and pin holes (python/scripts/make_meshes.py --tet10).
  // The mesh volume matches the exact CAD volume to 4e-6.
  //
  // The bolt holes are clamped. Each load case is a uniform traction on the
  // pin-hole surface - vertical, then lateral - scaled so that its resultant
  // on the exact cylinder is 12 kN (5 kN); each Tet10 face integrates it
  // consistently.
  //
  // Used by scripts/run_cross_validation.sh: scikit-fem (ElementTetP2 on an
  // isoparametric MeshTet2) and CalculiX (C3D10) solve the same discrete
  // problem from this run's mesh.json and exported decks.
  // ---------------------------------------------------------------------------
  "name": "engine_mount_tet10_analysis",
  "description": "Gmsh engine mount on curved quadratic tetrahedra (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "file",
    "path": "../meshes/engine_mount_3d_tet10.inp",
    "scale": 0.001
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "boundary_conditions": [
    { "name": "bolts", "fix": ["x", "y", "z"], "region": { "group": "bolt_holes" } }
  ],

  "load_cases": [
    {
      "name": "vertical",
      // 12 kN / (2 pi 10 mm x 60 mm)
      "tractions": [
        { "name": "pin", "traction": [0.0, 0.0, -3.183098861837907e6], "region": { "group": "pin_hole" } }
      ]
    },
    {
      "name": "lateral",
      // 5 kN over the same surface
      "tractions": [
        { "name": "pin", "traction": [1.3262911924324612e6, 0.0, 0.0], "region": { "group": "pin_hole" } }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "auto", "iterative_tolerance": 1e-11, "residual_tolerance": 1e-8 }
  },

  "modal": { "enabled": false },

  "output": { "csv": true, "vtk": true }
}
