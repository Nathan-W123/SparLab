{
  // ---------------------------------------------------------------------------
  // The Gmsh lug bracket (lug_bracket_2d.json) as a static analysis with a
  // Poisson ratio of zero, for the cross-validation only.
  //
  // CalculiX expands its plane elements (CPS3 here) into a thin 3-D layer,
  // which coincides with the plane-stress idealisation only when nu = 0. At
  // nu = 0 the comparison is between two codes solving the same discrete
  // problem on the same unstructured triangle mesh, and must agree to the
  // six-digit rounding of CalculiX's result file; at the lug's real nu = 0.33
  // the two idealisations differ by about 1e-3, which the cross-validation
  // records as informational.
  // ---------------------------------------------------------------------------
  "name": "lug_bracket_nu0_analysis",
  "description": "Gmsh lug bracket (Tri3), nu = 0, static analysis for the CalculiX comparison",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "file", "path": "../meshes/lug_bracket_2d.msh", "scale": 0.001 },

  "material": {
    "name": "Al 7075-T6 stiffness, nu = 0",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.0,
    "density": 2810.0
  },

  "model": { "thickness": 0.006, "stress_state": "plane_stress" },

  "boundary_conditions": [
    { "name": "bolts", "fix": ["x", "y"], "region": { "group": "bolt_holes" } }
  ],

  "load_cases": [
    {
      "name": "pin_down",
      "point_loads": [
        { "force": [0.0, -4000.0], "distribution": "total", "region": { "group": "load_hole" } }
      ]
    },
    {
      "name": "pin_sideways",
      "point_loads": [
        { "force": [2500.0, 0.0], "distribution": "total", "region": { "group": "load_hole" } }
      ]
    }
  ],

  "solver": { "linear": { "type": "auto", "residual_tolerance": 1e-8 } },
  "modal": { "enabled": false }
}
