{
  // ---------------------------------------------------------------------------
  // Cross-validation of frictionless contact against a moving rigid plane on
  // Tet4 (C3D4) elements: an aluminium block 0.2 x 0.1 x 0.1 m held at its
  // top, a rigid plane touching its bottom and rising by 0.2 mm, which the
  // compressed block's bottom widens along. scikit-fem solves the same
  // discrete problem. CalculiX has the plane as one element whose face lies
  // on it and whose nodes move with it: against a flat master parallel to
  // the slave surface the dual mortar constraint is the rigid plane's
  // exactly (a mortar pair presses along the slave's normal, a rigid
  // obstacle along its own - measured: tilted by 0.002 rad, the plane left
  // 3.2e-3 of the displacement between the two). One step, as CalculiX's
  // mortar contact takes the contact geometry at the start of every
  // increment (see contact_blocks_hex_nonlinear).
  // ---------------------------------------------------------------------------
  "name": "contact_plane_tet4_nonlinear",
  "description": "Block pressed by a rising rigid plane, frictionless, Tet4 (C3D4) elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": { "type": "structured_tet", "nx": 8, "ny": 4, "nz": 4, "lx": 0.2, "ly": 0.1, "lz": 0.1 },

  "material": { "name": "aluminium", "youngs_modulus": 70.0e9, "poisson_ratio": 0.3, "density": 2700.0 },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "top", "fix": ["x", "y", "z"], "region": { "box": { "ymin": 0.1 } } }
  ],

  "load_cases": [ { "name": "rise", "prescribed_displacement_only": true } ],

  "solver": { "linear": { "type": "simplicial_ldlt" } },

  "nonlinear": {
    "enabled": true,
    "kinematics": "small_strain",
    "steps": 1,
    "residual_tolerance": 1e-12,
    "displacement_tolerance": 1e-12,
    "max_iterations": 60
  },

  "contact": {
    "enabled": true,
    "pairs": [ { "name": "floor", "slave": { "box": { "ymax": 0.0 } },
                 "obstacle": { "type": "plane", "point": [0.0, 0.0, 0.0], "normal": [0.0, 1.0, 0.0],
                               "motion": [0.0, 2.0e-4, 0.0] } } ]
  },

  "output": { "csv": true, "vtk": true }
}
