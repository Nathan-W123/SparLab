{
  // ---------------------------------------------------------------------------
  // Linear buckling cross-validation deck: a 1 m steel column of 50 mm square
  // section, clamped at x = 0 and loaded by a 1 N axial compressive traction
  // on its free end, on Hex8 (C3D8, 2 x 2 x 2 points) elements - the
  // 3-D case of sparlab_verify's buckling-euler study, so the first load
  // factor is the critical load in newtons (Euler with Engesser's shear
  // correction: 256 609 N).
  //
  // scripts/run_cross_validation.sh solves it with sparlab_solve (static and
  // buckling), exports the CalculiX deck, and python/scripts/cross_validate.py
  // re-solves it in CalculiX both as a static step and as a *BUCKLE step on
  // the same mesh, nodal loads and supports: the displacements and the load
  // factors are compared.
  // ---------------------------------------------------------------------------
  "name": "column_hex_buckling_analysis",
  "description": "Axially loaded column for the buckling cross-validation (Hex8 (C3D8, 2 x 2 x 2 points))",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_hex",
    "nx": 40, "ny": 4, "nz": 4,
    "lx": 1.0,
    "ly": 0.05,
    "lz": 0.05
  },

  "material": {
    "name": "steel",
    "youngs_modulus": 200.0e9,
    "poisson_ratio": 0.3,
    "density": 7850.0
  },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "clamped_base", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    {
      "name": "axial",
      "tractions": [
        { "name": "end_face", "traction": [-400.0, 0.0, 0.0], "region": { "box": { "xmin": 1.0 } } }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 },
    "equilibrium_tolerance": 1e-6
  },

  "modal": { "enabled": false },

  "buckling": { "enabled": true, "num_modes": 4, "tolerance": 1e-10, "residual_tolerance": 1e-8 },

  "output": { "csv": true, "vtk": false }
}
