{
  // ---------------------------------------------------------------------------
  // cantilever_analysis.json on linear triangles: the same grid with every
  // quadrilateral split into two Tri3 along alternating diagonals. Used by the
  // cross-validation against CalculiX (CPS3) and scikit-fem (ElementTriP1).
  // The constant-strain triangle is stiffer in bending than the Q4, so this
  // deck is not a beam-theory reference at this resolution; the comparison is
  // between codes solving the same discrete problem.
  //
  // Geometry matches the validation cantilever used by `sparlab_verify`:
  // L = 1 m, h = 0.1 m (L/h = 10), t = 10 mm, aluminium, 1 kN tip resultant.
  // Poisson's ratio is set to 0 so the plane-stress result can be compared with
  // 1-D beam theory without the anticlastic effect that beam theory omits.
  // ---------------------------------------------------------------------------
  "name": "cantilever_tri_analysis",
  "description": "The analysis cantilever on Tri3 elements (cross-validation deck)",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_tri",
    "nx": 120,
    "ny": 12,
    "lx": 1.0,
    "ly": 0.1
  },

  "material": {
    "name": "aluminium_nu0",
    "youngs_modulus": 70.0e9,
    "poisson_ratio": 0.0,
    "density": 2700.0
  },

  "model": {
    "thickness": 0.01,
    "stress_state": "plane_stress"
  },

  "boundary_conditions": [
    {
      "name": "clamped_root",
      "fix": ["x", "y"],
      "region": { "box": { "xmax": 0.0 } }
    }
  ],

  "load_cases": [
    {
      "name": "tip_load",
      "weight": 1.0,
      "point_loads": [
        {
          "name": "tip_edge",
          "force": [0.0, -1000.0],
          "distribution": "total",
          "region": { "box": { "xmin": 1.0 } }
        }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 },
    "equilibrium_tolerance": 1e-6
  },

  "modal": {
    "enabled": true,
    "num_modes": 6,
    "mass_type": "consistent",
    "tolerance": 1e-10,
    "residual_tolerance": 1e-6
  },

  "topology": { "enabled": false },

  "output": { "csv": true, "vtk": true, "mode_shapes": true }
}
