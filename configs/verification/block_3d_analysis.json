{
  // ---------------------------------------------------------------------------
  // Static + modal analysis of a solid cantilever block (Hex8).
  //
  // The 3-D counterpart of cantilever_analysis.json: a 0.5 x 0.1 x 0.05 m
  // aluminium bar clamped on its x = 0 face with a downward tip load spread
  // over the tip face and a lateral pressure on its top face. Used by the
  // cross-validation against CalculiX (C3D8) and scikit-fem (ElementHex1) and
  // as the 3-D example for the static/modal figures.
  // ---------------------------------------------------------------------------
  "name": "block_3d_analysis",
  "description": "Solid cantilever block, static tip load and top-face traction, plus modal",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_hex",
    "nx": 40,
    "ny": 8,
    "nz": 4,
    "lx": 0.5,
    "ly": 0.1,
    "lz": 0.05
  },

  "material": {
    "name": "Al 6061-T6",
    "youngs_modulus": 68.9e9,
    "poisson_ratio": 0.33,
    "density": 2700.0
  },

  "model": {
    "stress_state": "three_dimensional",
    "integration": { "stiffness_points": 2, "mass_points": 3, "face_points": 2 }
  },

  "boundary_conditions": [
    { "name": "clamped_root", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    {
      "name": "tip_load",
      "point_loads": [
        { "name": "tip_face", "force": [0.0, -1000.0, 0.0], "distribution": "total",
          "region": { "box": { "xmin": 0.5 } } }
      ]
    },
    {
      "name": "top_pressure",
      "tractions": [
        { "name": "top_face", "traction": [0.0, 0.0, -2.0e5],
          "region": { "box": { "zmin": 0.05 } } }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 },
    "equilibrium_tolerance": 1e-6
  },

  "modal": { "enabled": true, "num_modes": 6, "mass_type": "consistent" },

  "output": { "csv": true, "vtk": true, "mode_shapes": true }
}
