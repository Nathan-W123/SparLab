{
  // ---------------------------------------------------------------------------
  // Benchmark 1: tip-loaded cantilever beam.
  //
  // The classic minimum-compliance test case. A rectangular design domain is
  // clamped along its left edge and carries a downward resultant at the middle
  // of its right edge. The optimum is the familiar two-bar / tied-arch layout.
  //
  // Units are SI throughout: metres, newtons, pascals, kilograms.
  // Material: 7075-T6 aluminium (E = 71.7 GPa, nu = 0.33, rho = 2810 kg/m^3).
  // ---------------------------------------------------------------------------
  "name": "cantilever_beam",
  "description": "Tip-loaded cantilever, minimum compliance at 40% volume fraction",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_quad",
    "nx": 160,
    "ny": 80,
    "lx": 0.4,
    "ly": 0.2
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "model": {
    "thickness": 0.004,
    "stress_state": "plane_stress",
    "integration": { "stiffness_points": 2, "mass_points": 3, "edge_points": 2 }
  },

  "boundary_conditions": [
    {
      "name": "clamped_root",
      "fix": ["x", "y"],
      "region": { "box": { "xmax": 0.0 } }
    }
  ],

  "load_cases": [
    {
      "name": "tip_down",
      "weight": 1.0,
      // The resultant is spread over the three tip nodes closest to mid-height
      // so the total force stays mesh independent while avoiding a single-node
      // stress singularity.
      "point_loads": [
        {
          "name": "tip",
          "force": [0.0, -2000.0],
          "distribution": "total",
          "region": { "box": { "xmin": 0.4, "ymin": 0.0975, "ymax": 0.1025 } }
        }
      ]
    }
  ],

  "solver": {
    "linear": {
      "type": "simplicial_ldlt",
      "residual_tolerance": 1e-8,
      "pivot_tolerance": 1e-14
    },
    "equilibrium_tolerance": 1e-6
  },

  "modal": {
    "enabled": true,
    "num_modes": 6,
    "mass_type": "consistent",
    "tolerance": 1e-10,
    "residual_tolerance": 1e-6
  },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.4,
    "simp": {
      "penalty": 3.0,
      "emin_ratio": 1e-9,
      "mass_interpolation": "penalty_matched"
    },
    "filter": {
      "type": "density",
      "radius_elements": 2.0
    },
    "optimizer": {
      "max_iterations": 600,
      // Two independent stop criteria; either one ends the loop and the
      // summary records which fired plus the final value of both.
      //
      //  * change_tolerance 1e-2 is the classic SIMP/OC criterion. On fine
      //    meshes it is met only intermittently, because thin members migrate
      //    one cell at a time long after the objective has settled.
      //  * objective_tolerance 2e-5 over a 20-iteration window is the backstop
      //    that actually terminates fine-mesh runs. Measured on the cantilever
      //    benchmark, stopping at this point gives a compliance within about
      //    0.1% of an 800-iteration run (see docs/benchmarks.md).
      "change_tolerance": 1e-2,
      "objective_tolerance": 5e-5,
      "objective_window": 20,
      "move_limit": 0.2,
      "damping": 0.5,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": true }
}
