{
  // ---------------------------------------------------------------------------
  // Benchmark 3b: wing-rib web design domain.
  //
  // The in-plane web of a wing rib between a front and a rear spar. Chordwise
  // extent x, rib depth y, with the skins attached along the top and bottom
  // edges. Skin pressure is applied as distributed edge tractions, so the load
  // is mesh independent and integrated consistently rather than lumped.
  //
  //   y
  //   0.10 +==========================================+   <- upper skin
  //        |F|                                      |R|
  //        |S|            design domain             |S|
  //        |P|      (o)  system cutouts   (o)       |P|
  //   0.00 +==========================================+   <- lower skin
  //        0.00                                    0.50  x
  //
  //   FSP: front spar attachment (fixed in x and y)
  //   RSP: rear spar attachment (vertical roller, free chordwise)
  //
  // Load cases are representative, not certified flight loads:
  //   * positive_manoeuvre: chordwise-decaying download on the upper skin plus
  //     a download on the lower skin (rib crushing under positive lift),
  //   * negative_manoeuvre: reversed, at a lower factor,
  //   * fitting_load: a systems/actuator fitting picked up at mid chord.
  // ---------------------------------------------------------------------------
  "name": "wing_rib",
  "description": "Wing-rib web between two spars, distributed skin loads, 40% volume",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_quad",
    "nx": 250,
    "ny": 50,
    "lx": 0.50,
    "ly": 0.10
  },

  "material": {
    "name": "Al 2024-T3",
    "youngs_modulus": 73.1e9,
    "poisson_ratio": 0.33,
    "density": 2780.0
  },

  "model": {
    "thickness": 0.002,
    "stress_state": "plane_stress"
  },

  "boundary_conditions": [
    {
      "name": "front_spar_attachment",
      "fix": ["x", "y"],
      "region": { "box": { "xmax": 0.010 } }
    },
    {
      // A vertical roller at the rear spar: the rib is restrained vertically
      // but free to grow chordwise, which is the usual idealisation for a rib
      // that is not the primary chordwise load path.
      "name": "rear_spar_attachment",
      "fix": ["y"],
      "region": { "box": { "xmin": 0.490 } }
    }
  ],

  // Chordwise pressure varies strongly over a real aerofoil, peaking near the
  // leading edge. A *uniform* pressure on a shallow web is the degenerate case
  // for compliance optimisation - its optimum is a uniform web - so the upper
  // skin load is applied as four chordwise bands approximating a decaying
  // distribution. This is a piecewise-constant approximation to a pressure
  // distribution, not a computed aerodynamic load.
  "load_cases": [
    {
      "name": "positive_manoeuvre",
      "weight": 1.0,
      "tractions": [
        { "name": "upper_skin_band1", "traction": [0.0, -2.4e5],
          "region": { "box": { "ymin": 0.10, "xmax": 0.125 } } },
        { "name": "upper_skin_band2", "traction": [0.0, -1.4e5],
          "region": { "box": { "ymin": 0.10, "xmin": 0.125, "xmax": 0.250 } } },
        { "name": "upper_skin_band3", "traction": [0.0, -0.8e5],
          "region": { "box": { "ymin": 0.10, "xmin": 0.250, "xmax": 0.375 } } },
        { "name": "upper_skin_band4", "traction": [0.0, -0.4e5],
          "region": { "box": { "ymin": 0.10, "xmin": 0.375 } } },
        { "name": "lower_skin_down", "traction": [0.0, -0.4e5],
          "region": { "box": { "ymax": 0.00 } } }
      ]
    },
    {
      "name": "negative_manoeuvre",
      "weight": 0.4,
      "tractions": [
        { "name": "upper_skin_up", "traction": [0.0, 0.8e5],
          "region": { "box": { "ymin": 0.10, "xmax": 0.250 } } },
        { "name": "upper_skin_up_aft", "traction": [0.0, 0.3e5],
          "region": { "box": { "ymin": 0.10, "xmin": 0.250 } } },
        { "name": "lower_skin_up", "traction": [0.0, 0.2e5],
          "region": { "box": { "ymax": 0.00 } } }
      ]
    },
    {
      // A systems / actuator fitting picked up at mid chord on the lower skin.
      // This is the load case that gives the rib web a genuine load path to
      // find, rather than a near-uniform pressure whose optimum is a uniform
      // web.
      "name": "fitting_load",
      "weight": 0.6,
      "point_loads": [
        { "name": "mid_chord_fitting", "force": [0.0, -4000.0],
          "distribution": "total",
          "region": { "box": { "ymax": 0.006, "xmin": 0.245, "xmax": 0.265 } } }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 },
    "equilibrium_tolerance": 1e-6
  },

  "modal": {
    "enabled": true,
    "num_modes": 6,
    "mass_type": "consistent",
    "analyse_optimised_topology": true,
    "compare_mass_matched_baseline": true
  },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.40,
    "simp": { "penalty": 3.0, "emin_ratio": 1e-9,
              "mass_interpolation": "penalty_matched" },
    "filter": { "type": "density", "radius_elements": 2.0 },
    "optimizer": {
      "max_iterations": 600,
      // Two independent stop criteria; either one ends the loop and the
      // summary records which fired plus the final value of both.
      //
      //  * change_tolerance 1e-2 is the classic SIMP/OC criterion. On fine
      //    meshes it is met only intermittently, because thin members migrate
      //    one cell at a time long after the objective has settled.
      //  * objective_tolerance 2e-5 over a 20-iteration window is the backstop
      //    that actually terminates fine-mesh runs. Measured on the cantilever
      //    benchmark, stopping at this point gives a compliance within about
      //    0.1% of an 800-iteration run (see docs/benchmarks.md).
      "change_tolerance": 1e-2,
      "objective_tolerance": 5e-5,
      "objective_window": 20,
      "move_limit": 0.2,
      "continuation_steps": 3,
      "penalty_start": 1.5,
      "continuation_iterations": 30,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    },
    "passive_regions": [
      {
        "name": "spar_attachment_pads",
        "type": "solid",
        "region": {
          "any_of": [
            { "box": { "xmax": 0.014 } },
            { "box": { "xmin": 0.486 } }
          ]
        }
      },
      {
        // One element deep: the land the skin fasteners pick up. A thicker
        // passive flange consumes most of the volume budget and leaves the free
        // variables at a mean density near 0.2, which produces a grey,
        // island-prone design rather than a resolved truss.
        "name": "skin_attachment_flanges",
        "type": "solid",
        "region": {
          "any_of": [
            { "box": { "ymin": 0.0981 } },
            { "box": { "ymax": 0.0019 } }
          ]
        }
      },
      {
        "name": "system_cutouts",
        "type": "void",
        "region": {
          "any_of": [
            { "circle": { "center": [0.170, 0.050], "radius": 0.016 } },
            { "circle": { "center": [0.330, 0.050], "radius": 0.016 } }
          ]
        }
      }
    ]
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": true }
}
