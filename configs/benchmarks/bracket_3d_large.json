{
  // ---------------------------------------------------------------------------
  // Benchmark 10: the solid wall bracket at 356 475 unknowns (Hex8, multigrid).
  //
  // The same block, supports and load cases as bracket_3d, on a mesh refined
  // three times in every direction: 96 x 48 x 24 = 110 592 Hex8 with a 2.5 mm
  // cell, 356 475 DOFs - 23.5 times the unknowns of bracket_3d. A sparse
  // Cholesky factorisation of this matrix is out of reach (the measured cost
  // grows like n^2.35 and takes 43 s at 47 775 unknowns; docs/benchmarks.md),
  // so the deck uses conjugate gradients preconditioned by smoothed-aggregation
  // multigrid, warm-started from the previous design and reusing its
  // aggregates between design iterations.
  //
  // The filter radius stays 1.5 cells, so the finer mesh resolves thinner
  // members rather than reproducing bracket_3d's design; the Heaviside
  // projection (beta 1 -> 16) keeps the finer design crisp, and the run stops
  // on the objective stalling at the final beta.
  //
  // Units are SI throughout. Material: 7075-T6 aluminium.
  // ---------------------------------------------------------------------------
  "name": "bracket_3d_large",
  "description": "Solid wall bracket at 356k DOFs: AMG-preconditioned CG and Heaviside projection",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_hex",
    "nx": 96,
    "ny": 48,
    "nz": 24,
    "lx": 0.24,
    "ly": 0.12,
    "lz": 0.06
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "model": { "stress_state": "three_dimensional" },

  "boundary_conditions": [
    { "name": "wall_face", "fix": ["x", "y", "z"], "region": { "box": { "xmax": 0.0 } } }
  ],

  "load_cases": [
    {
      "name": "down_limit",
      "weight": 1.0,
      "point_loads": [
        {
          "name": "tip_bottom_edge",
          "force": [0.0, -3000.0, 0.0],
          "distribution": "total",
          "region": { "box": { "xmin": 0.24, "ymax": 0.0 } }
        }
      ]
    },
    {
      "name": "lateral",
      "weight": 0.5,
      "point_loads": [
        {
          "name": "tip_mid_line",
          "force": [0.0, 0.0, 1200.0],
          "distribution": "total",
          "region": { "box": { "xmin": 0.24, "ymin": 0.0585, "ymax": 0.0615 } }
        }
      ]
    }
  ],

  "solver": {
    "linear": {
      "type": "amg_cg",
      "iterative_tolerance": 1e-10,
      "residual_tolerance": 1e-8,
      "warm_start": true,
      "amg": { "smoother": "chebyshev", "smoother_degree": 3, "reuse_aggregates": true }
    },
    "equilibrium_tolerance": 1e-6
  },

  "modal": { "enabled": true, "num_modes": 4, "tolerance": 1e-8 },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.3,
    "simp": { "penalty": 3.0, "emin_ratio": 1e-9 },
    "filter": { "type": "density", "radius_elements": 1.5 },
    "projection": {
      "enabled": true,
      "eta": 0.5,
      "beta_start": 1.0,
      "beta_max": 16.0,
      "beta_factor": 2.0,
      "beta_interval": 40
    },
    "optimizer": {
      "max_iterations": 300,
      "change_tolerance": 1e-2,
      "objective_tolerance": 1e-3,
      "objective_window": 10,
      "move_limit": 0.1,
      "history_stride": 10
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": true }
}
