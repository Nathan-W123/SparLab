{
  // ---------------------------------------------------------------------------
  // Benchmark 8: lug bracket from a Gmsh mesh (two-dimensional, Tri3).
  //
  // Real geometry instead of a box: a 200 x 100 mm plate with 10 mm corner
  // fillets, two 16 mm bolt holes on the left and a 20 mm lug hole on the
  // right, meshed with 20 336 linear triangles by python/scripts/make_meshes.py
  // (Gmsh 4.15.2, element size 1.5 mm). The geometry is in millimetres; the
  // deck reads it with mesh.scale = 0.001.
  //
  // Supports and loads address the mesh's physical groups by name: the bolt
  // hole edges are clamped, the lug hole takes a downward and a sideways pin
  // load (two load cases), and an 8 mm ring of material around every hole is
  // kept solid so the holes stay holes in the optimised part.
  //
  // The Heaviside projection sharpens the density field during the run, so
  // the thresholded part that is exported is the structure the optimiser
  // actually evaluated rather than a grey approximation of it.
  //
  // Material: 7075-T6 aluminium, 6 mm plate, plane stress.
  // ---------------------------------------------------------------------------
  "name": "lug_bracket_2d",
  "description": "Gmsh lug bracket (Tri3), two pin load cases, 35% volume, Heaviside projection",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "file",
    "path": "../meshes/lug_bracket_2d.msh",
    "scale": 0.001
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "model": { "thickness": 0.006, "stress_state": "plane_stress" },

  "boundary_conditions": [
    { "name": "bolts", "fix": ["x", "y"], "region": { "group": "bolt_holes" } }
  ],

  "load_cases": [
    {
      "name": "pin_down",
      "weight": 1.0,
      "point_loads": [
        { "force": [0.0, -4000.0], "distribution": "total", "region": { "group": "load_hole" } }
      ]
    },
    {
      "name": "pin_sideways",
      "weight": 1.0,
      "point_loads": [
        { "force": [2500.0, 0.0], "distribution": "total", "region": { "group": "load_hole" } }
      ]
    }
  ],

  "solver": { "linear": { "type": "auto", "residual_tolerance": 1e-8 } },

  "modal": { "enabled": true, "num_modes": 4 },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.35,
    "simp": { "penalty": 3.0, "emin_ratio": 1e-9 },
    "filter": { "type": "density", "radius_elements": 2.5 },
    "passive_regions": [
      { "name": "hole_rims", "type": "solid", "region": { "group": "hole_rims" } }
    ],
    "projection": {
      "enabled": true,
      "eta": 0.5,
      "beta_start": 1.0,
      "beta_max": 32.0,
      "beta_factor": 2.0,
      "beta_interval": 40
    },
    // With a sharp projection the design-change measure never settles: single
    // elements at the solid-void interface keep flipping by the full move
    // limit while the compliance is stationary. The run therefore stops on
    // the objective stalling (0.1 % over 10 iterations) at the final beta,
    // and a move limit of 0.1 damps the flipping.
    "optimizer": {
      "max_iterations": 400,
      "change_tolerance": 1e-2,
      "objective_tolerance": 1e-3,
      "objective_window": 10,
      "move_limit": 0.1,
      "history_stride": 2
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": true }
}
