{
  // ---------------------------------------------------------------------------
  // Benchmark 13: the MBB beam with the robust formulation.
  //
  // mbb_beam_projected unchanged - mesh, load, filter radius (4.5 cells), the
  // beta schedule (1 -> 32), OC and its stopping rule - except that
  // topology.projection.robust is on. The objective is then the compliance
  // of the eroded design (threshold eta + 0.1 = 0.6), the volume constraint
  // holds the dilated design (eta - 0.1 = 0.4) to a target rescaled every
  // iteration so that the blueprint (eta = 0.5) meets the 50 % fraction, and
  // the blueprint is what is reported and exported (Wang, Lazarov and
  // Sigmund 2011). A design whose members survive erosion has no member
  // thinner than the erosion removes: the formulation imposes a minimum
  // solid size, and by the dilated design a minimum gap.
  //
  // The dilated design's volume target is rescaled every 20 iterations
  // (robust_volume_interval). Rescaled at every iteration, the OC update
  // locked into a period-2 cycle as soon as beta reached 32, the eroded
  // volume fraction alternating between 0.45 and 0.48.
  //
  // topology.length_scale_check scans the thresholded blueprint with
  // morphological openings and closings and reports the smallest member and
  // gap it finds. The same deck run with --no-robust is mbb_beam_projected
  // plus that check and projection.erosion_check, which evaluates the
  // non-robust design at the eroded and dilated thresholds once at the end
  // (scripts/run_all_benchmarks.sh writes it to mbb_beam_robust_off): the two
  // designs' length scales and their sensitivity to a part that comes out
  // thinner or thicker compare like for like (docs/benchmarks.md, section 13).
  // ---------------------------------------------------------------------------
  "name": "mbb_beam_robust",
  "description": "MBB beam half model, 50% volume fraction, robust projection (eta 0.5 +- 0.1, beta 1 -> 32)",
  "units": "SI, with E = 1 Pa and a 1 m x 1 m x 1 m cell (dimensionless benchmark)",

  "mesh": {
    "type": "structured_quad",
    "nx": 180,
    "ny": 60,
    "lx": 180.0,
    "ly": 60.0
  },

  "material": {
    "name": "unit_material",
    "youngs_modulus": 1.0,
    "poisson_ratio": 0.3,
    "density": 1.0
  },

  "model": {
    "thickness": 1.0,
    "stress_state": "plane_stress"
  },

  "boundary_conditions": [
    {
      "name": "symmetry_plane",
      "fix": ["x"],
      "region": { "box": { "xmax": 0.0 } }
    },
    {
      "name": "roller_support",
      "fix": ["y"],
      "region": { "nearest_node": [180.0, 0.0] }
    }
  ],

  "load_cases": [
    {
      "name": "midspan_load",
      "weight": 1.0,
      "point_loads": [
        {
          "name": "top_left_corner",
          "force": [0.0, -1.0],
          "distribution": "total",
          "region": { "nearest_node": [0.0, 60.0] }
        }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 },
    "equilibrium_tolerance": 1e-6
  },

  "modal": { "enabled": false },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.5,
    "simp": { "penalty": 3.0, "emin_ratio": 1e-9 },
    "filter": {
      "type": "density",
      // 4.5 cells at 180 x 60 is the same physical radius as the customary
      // 1.5 cells at 60 x 20, so the minimum length scale is mesh independent.
      "radius_elements": 4.5
    },
    "projection": {
      "enabled": true,
      "eta": 0.5,
      "beta_start": 1.0,
      "beta_max": 32.0,
      "beta_factor": 2.0,
      "beta_interval": 40,
      "robust": true,
      "robust_delta": 0.1,
      "robust_volume_interval": 20,
      "erosion_check": true
    },
    // Probe radii from half a cell to 8 cells; a probe whose opening removes
    // more than 2 % of the solid (or whose closing fills more than 2 % of
    // the void) marks a member (gap) narrower than it.
    "length_scale_check": { "enabled": true, "max_radius_elements": 8.0, "tolerance": 0.02 },
    "optimizer": {
      "max_iterations": 400,
      "change_tolerance": 1e-2,
      "objective_tolerance": 1e-3,
      "objective_window": 10,
      "move_limit": 0.1,
      "damping": 0.5,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true }
}
