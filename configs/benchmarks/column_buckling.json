{
  // ---------------------------------------------------------------------------
  // Benchmark 12: a column under an axial load, with a lower bound on its
  // linear buckling load factor.
  //
  // A 0.5 m x 1 m plate, 10 mm thick, clamped along its base and loaded by
  // 100 kN of axial compression on a 0.1 m pad at the middle of its top edge.
  // For minimum compliance alone the best use of a quarter of the material is
  // a straight, slender strut under the pad - the stiffest layout and one that
  // buckles well below any sensible safety factor. The constraint
  // topology.buckling_constraint asks for the six lowest positive load
  // factors of (K + lambda K_G) phi = 0 to stay at or above 6: buckling at no
  // less than six times the design load.
  //
  // Settings, chosen in trial runs before they went into this deck (the
  // committed comparison runs are in docs/benchmarks.md, section 12):
  //
  //  * MMA, which a second constraint needs; move limit 0.05, because with
  //    the larger default the load factors jump between iterations while the
  //    buckling mode switches, and MMA's subproblem gets up to 3000 Newton
  //    iterations for the same reason.
  //  * The robust formulation (topology.projection.robust): the objective and
  //    the buckling constraint act on the eroded design, the volume on the
  //    dilated one, and the blueprint is exported. Without it the optimiser
  //    meets lambda >= 6 on the SIMP model with bracing of intermediate
  //    density, or one element thick and joined at element corners, that the
  //    thresholded part does not have; the part then buckles well below 6.
  //    The comparison runs (scripts/run_all_benchmarks.sh) repeat this deck
  //    with --no-robust and with --no-buckling-constraint.
  //  * Filter radius 3 elements and robust_delta 0.05. At a radius of 1.5
  //    elements the trial runs thinned bracing to one element; with
  //    robust_delta 0.1 at radius 3 the eroded design stayed infeasible
  //    (lambda_1 below 6) through a 600-iteration trial.
  //  * The buckling section checks the full solid domain and the exported
  //    part (thresholded at 0.5, full material) after the run: the numbers
  //    that say whether the part, not the SIMP model, meets the requirement.
  //
  // Units are SI throughout: metres, newtons, pascals, kilograms.
  // Material: 7075-T6 aluminium (E = 71.7 GPa, nu = 0.33, rho = 2810 kg/m^3).
  // ---------------------------------------------------------------------------
  "name": "column_buckling",
  "description": "Axially loaded column, minimum compliance at 25% volume with buckling load factor >= 6",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_quad",
    "nx": 40,
    "ny": 80,
    "lx": 0.5,
    "ly": 1.0
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "model": {
    "thickness": 0.01,
    "stress_state": "plane_stress"
  },

  "boundary_conditions": [
    {
      "name": "base",
      "fix": ["x", "y"],
      "region": { "box": { "ymax": 0.0 } }
    }
  ],

  "load_cases": [
    {
      "name": "axial",
      "point_loads": [
        {
          "name": "top_pad",
          "force": [0.0, -1.0e5],
          "distribution": "total",
          "region": { "box": { "ymin": 1.0, "xmin": 0.2, "xmax": 0.3 } }
        }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 },
    "equilibrium_tolerance": 1e-6
  },

  // Post-run check: the lowest four load factors of the full solid domain and
  // of the exported part.
  "buckling": {
    "enabled": true,
    "num_modes": 4,
    "tolerance": 1e-8,
    "residual_tolerance": 1e-6
  },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.25,
    "simp": { "penalty": 3.0, "emin_ratio": 1e-9 },
    "filter": { "type": "density", "radius_elements": 3.0 },
    "optimizer": {
      "method": "mma",
      "max_iterations": 800,
      "change_tolerance": 1e-2,
      "objective_tolerance": 1e-4,
      "objective_window": 10,
      "move_limit": 0.05,
      "history_stride": 1,
      "interpretation_threshold": 0.5,
      "mma": { "max_newton_iterations": 3000 }
    },
    "projection": {
      "enabled": true,
      "eta": 0.5,
      "beta_start": 1.0,
      "beta_max": 16.0,
      "beta_factor": 2.0,
      "beta_interval": 50,
      "robust": true,
      "robust_delta": 0.05
    },
    "buckling_constraint": {
      "enabled": true,
      "min_load_factor": 6.0,
      "num_modes": 6,
      "ks_parameter": 40.0
    },
    // The loaded pad stays solid so the load always meets material.
    "passive_regions": [
      {
        "name": "pad",
        "type": "solid",
        "region": { "box": { "ymin": 0.975, "xmin": 0.2, "xmax": 0.3 } }
      }
    ]
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": true }
}
