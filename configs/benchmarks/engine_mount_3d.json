{
  // ---------------------------------------------------------------------------
  // Benchmark 9: engine mount from a Gmsh mesh (three-dimensional, Tet4).
  //
  // A 160 x 60 x 12 mm base slab with four vertical 10 mm bolt holes, and an
  // 80 x 60 x 78 mm upright block through which a 20 mm pin hole runs along y,
  // meshed with 39 936 linear tetrahedra (Gmsh 4.15.2, element size 4 mm) and
  // written as an Abaqus / CalculiX input file, so this deck exercises the
  // .inp reader on real mesher output. Geometry in millimetres, read with
  // mesh.scale = 0.001.
  //
  // The bolt-hole faces are clamped; the pin hole carries a vertical and a
  // lateral load case. Rings of material around every hole (6 mm around the
  // bolts, 8 mm around the pin) are kept solid.
  //
  // With about 25 000 unknowns the "auto" solver selects multigrid CG (its
  // direct-factorisation limit for solids is 10 000 unknowns); the Heaviside
  // projection runs to beta = 16.
  //
  // Material: 7075-T6 aluminium.
  // ---------------------------------------------------------------------------
  "name": "engine_mount_3d",
  "description": "Gmsh engine mount (Tet4), two pin load cases, 25% volume, AMG-CG, projection",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "file",
    "path": "../meshes/engine_mount_3d.inp",
    "scale": 0.001
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "boundary_conditions": [
    { "name": "bolts", "fix": ["x", "y", "z"], "region": { "group": "bolt_holes" } }
  ],

  "load_cases": [
    {
      "name": "vertical",
      "weight": 1.0,
      "point_loads": [
        { "force": [0.0, 0.0, -12000.0], "distribution": "total", "region": { "group": "pin_hole" } }
      ]
    },
    {
      "name": "lateral",
      "weight": 1.0,
      "point_loads": [
        { "force": [5000.0, 0.0, 0.0], "distribution": "total", "region": { "group": "pin_hole" } }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "auto", "iterative_tolerance": 1e-10, "residual_tolerance": 1e-8 }
  },

  "modal": { "enabled": true, "num_modes": 4 },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.25,
    // The solid rings are 12 % of the domain volume, and they count towards
    // the 25 % budget, so they take almost half of it. Started at the volume
    // fraction (0.25), the free elements would put the whole design well
    // above the target, and a move limit of 0.1 cannot bring it down in one
    // step: the first OC bisection has no volume to bracket and stops the
    // run. Started at 0.15, the design (rings included, at the first beta)
    // sits within 0.4 % of the target.
    "initial_density": 0.15,
    "simp": { "penalty": 3.0, "emin_ratio": 1e-9 },
    "filter": { "type": "density", "radius_elements": 1.8 },
    "passive_regions": [
      { "name": "rings", "type": "solid", "region": { "group": "rings" } }
    ],
    "projection": {
      "enabled": true,
      "eta": 0.5,
      "beta_start": 1.0,
      "beta_max": 16.0,
      "beta_factor": 2.0,
      "beta_interval": 40
    },
    // Stops on the objective stalling at the final beta (see lug_bracket_2d).
    "optimizer": {
      "max_iterations": 300,
      "change_tolerance": 1e-2,
      "objective_tolerance": 1e-3,
      "objective_window": 10,
      "move_limit": 0.1,
      "history_stride": 2
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": true }
}
