{
  // ---------------------------------------------------------------------------
  // Benchmark 6: stress-constrained L-bracket (MMA).
  //
  // The canonical stress-constrained test case. A square design domain has its
  // upper-right quadrant removed (passive void), is clamped along the top of the
  // remaining left arm, and is loaded downward at the tip of the lower arm
  // through a small passive solid pad, so the load-application stress is not
  // design dependent. Minimum compliance at 35 % volume drives material into
  // the re-entrant corner and concentrates stress there; adding the aggregated
  // von Mises constraint rounds that corner at a small cost in compliance.
  //
  // The stress limit below was set from the unconstrained MMA run of this deck
  // (same mesh, filter, volume fraction and move limit, stress constraint off):
  // its relaxed (rho^0.5) von Mises peak is 1.56e7 Pa at the re-entrant corner,
  // and the constrained run asks for 60 % of that (see docs/benchmarks.md).
  //
  // The move limit is 0.1 rather than the 0.2 used by the compliance-only
  // decks: with the adaptive p-norm scale the constraint surface moves between
  // iterations, and at 0.2 a handful of corner elements oscillate between
  // their bounds instead of settling.
  //
  // Units are SI throughout: metres, newtons, pascals, kilograms.
  // ---------------------------------------------------------------------------
  "name": "l_bracket_stress",
  "description": "L-bracket, minimum compliance at 35% volume with an aggregated von Mises limit",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_quad",
    "nx": 64,
    "ny": 64,
    "lx": 0.4,
    "ly": 0.4
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "model": {
    "thickness": 0.01,
    "stress_state": "plane_stress",
    "integration": { "stiffness_points": 2, "mass_points": 3, "edge_points": 2 }
  },

  "boundary_conditions": [
    {
      "name": "clamped_top",
      "fix": ["x", "y"],
      "region": { "box": { "ymin": 0.4, "xmax": 0.16 } }
    }
  ],

  "load_cases": [
    {
      "name": "tip",
      "weight": 1.0,
      "point_loads": [
        {
          "name": "tip_pad",
          "force": [0.0, -600.0],
          "distribution": "total",
          "region": { "box": { "xmin": 0.4, "ymin": 0.10, "ymax": 0.1375 } }
        }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8, "pivot_tolerance": 1e-14 },
    "equilibrium_tolerance": 1e-6
  },

  "modal": { "enabled": false },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.35,
    "simp": { "penalty": 3.0, "emin_ratio": 1e-9, "mass_interpolation": "penalty_matched" },
    "filter": { "type": "density", "radius_elements": 1.5 },
    "optimizer": {
      "method": "mma",
      "max_iterations": 300,
      "change_tolerance": 1e-2,
      "objective_tolerance": 5e-5,
      "objective_window": 20,
      "constraint_tolerance": 1e-4,
      "move_limit": 0.1,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    },
    "stress": {
      "enabled": true,
      "limit": 9.4e6,
      "p_norm": 8.0,
      "relaxation": 0.5,
      "scaling_blend": 0.5
    },
    "passive_regions": [
      { "name": "cutout", "type": "void",
        "region": { "box": { "xmin": 0.16, "ymin": 0.16 } } },
      { "name": "load_pad", "type": "solid",
        "region": { "box": { "xmin": 0.3625, "ymin": 0.0875, "ymax": 0.15 } } }
    ]
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": false }
}
