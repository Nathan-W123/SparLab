{
  // ---------------------------------------------------------------------------
  // Benchmark 14a: the MBB beam, printed - the additive-manufacturing overhang
  // filter.
  //
  // mbb_beam_projected unchanged except for topology.overhang and the
  // optimiser. The beam is built along +y, from its bottom edge (on the build
  // plate) up, and the overhang filter (Langelaar 2016) sits between the
  // density filter and the projection. An element can hold no more material than the smooth maximum
  // of the three elements below it - directly below and diagonally below -
  // so on these square cells no surface may lean more than 45 degrees from
  // the build direction without material underneath.
  //
  // After the run the thresholded design is checked against the same
  // stencil: every solid element off the plate needs a solid support. The
  // comparison runs (scripts/run_all_benchmarks.sh) repeat this deck with
  // --no-overhang-filter (the unfiltered projected design, checked for the
  // same build direction) and with --overhang -y (built from the top edge
  // down) (docs/benchmarks.md, section 14).
  //
  // The optimiser is MMA. With OC and mbb_beam_projected's settings the
  // filtered runs reached the 400-iteration cap locked in a period-2 cycle at
  // beta = 32: the compliance alternated within 0.4 % built +y, and between
  // 236 and 260 J built -y. A damping of 0.3 instead of 0.5 did not help
  // (292 J after 219 iterations built +y). MMA converged in both directions.
  // ---------------------------------------------------------------------------
  "name": "mbb_beam_overhang",
  "description": "MBB beam half model, 50% volume fraction, projection, overhang filter (build direction +y)",
  "units": "SI, with E = 1 Pa and a 1 m x 1 m x 1 m cell (dimensionless benchmark)",

  "mesh": {
    "type": "structured_quad",
    "nx": 180,
    "ny": 60,
    "lx": 180.0,
    "ly": 60.0
  },

  "material": {
    "name": "unit_material",
    "youngs_modulus": 1.0,
    "poisson_ratio": 0.3,
    "density": 1.0
  },

  "model": {
    "thickness": 1.0,
    "stress_state": "plane_stress"
  },

  "boundary_conditions": [
    {
      "name": "symmetry_plane",
      "fix": ["x"],
      "region": { "box": { "xmax": 0.0 } }
    },
    {
      "name": "roller_support",
      "fix": ["y"],
      "region": { "nearest_node": [180.0, 0.0] }
    }
  ],

  "load_cases": [
    {
      "name": "midspan_load",
      "weight": 1.0,
      "point_loads": [
        {
          "name": "top_left_corner",
          "force": [0.0, -1.0],
          "distribution": "total",
          "region": { "nearest_node": [0.0, 60.0] }
        }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 },
    "equilibrium_tolerance": 1e-6
  },

  "modal": { "enabled": false },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.5,
    "simp": { "penalty": 3.0, "emin_ratio": 1e-9 },
    "filter": {
      "type": "density",
      // 4.5 cells at 180 x 60 is the same physical radius as the customary
      // 1.5 cells at 60 x 20, so the minimum length scale is mesh independent.
      "radius_elements": 4.5
    },
    "projection": {
      "enabled": true,
      "eta": 0.5,
      "beta_start": 1.0,
      "beta_max": 32.0,
      "beta_factor": 2.0,
      "beta_interval": 40
    },
    "overhang": {
      "filter": true,
      "build_direction": "+y",
      "smax_exponent": 40.0,
      "smax_reference": 0.5,
      "smin_epsilon": 1e-4
    },
    "optimizer": {
      "method": "mma",
      "max_iterations": 400,
      "change_tolerance": 1e-2,
      "objective_tolerance": 1e-3,
      "objective_window": 10,
      "move_limit": 0.1,
      "damping": 0.5,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true }
}
