{
  // ---------------------------------------------------------------------------
  // Benchmark 3: aerospace-inspired mounting bracket.
  //
  // A machined-plate bracket that bolts to structure through two holes on the
  // left and transfers load through a pin joint (lug) on the right. Three load
  // cases represent a symmetric down-load, its reversal, and a lateral case.
  //
  //   y
  //   0.20 +--------------------------------------------+
  //        |   (o) upper bolt                           |
  //        |                                    (o) lug |
  //        |   (o) lower bolt                           |
  //   0.00 +--------------------------------------------+
  //        0.00                                      0.30  x
  //
  // Attachment representation
  //   * bolt holes and the lug hole are passive VOID regions (no material);
  //   * a bearing collar around each hole is a passive SOLID region, standing
  //     in for the machined boss that a real bracket needs there;
  //   * every node inside a bolt hole is fully constrained, i.e. the bolt shank
  //     is idealised as rigid;
  //   * the lug load is applied to the ring of nodes around the lug hole, i.e.
  //     the pin transfers load through bearing on the hole wall.
  //
  // These are *representations* of attachment hardware, not a certified joint
  // model: no bearing compliance, no fastener flexibility, no bolt preload and
  // no out-of-plane behaviour are included. See docs/limitations.md.
  //
  // Material: 7075-T6 aluminium plate. Units are SI.
  // ---------------------------------------------------------------------------
  "name": "aerospace_bracket",
  "description": "Two-bolt machined bracket with a pin lug, three load cases, 35% volume",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_quad",
    "nx": 240,
    "ny": 160,
    "lx": 0.30,
    "ly": 0.20
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "model": {
    "thickness": 0.008,
    "stress_state": "plane_stress",
    "integration": { "stiffness_points": 2, "mass_points": 3, "edge_points": 2 }
  },

  "boundary_conditions": [
    {
      // Rigid bolt shanks: all nodes inside either bolt hole are fixed.
      "name": "bolt_attachments",
      "fix": ["x", "y"],
      "region": {
        "any_of": [
          { "circle": { "center": [0.030, 0.045], "radius": 0.0105 } },
          { "circle": { "center": [0.030, 0.155], "radius": 0.0105 } }
        ]
      }
    }
  ],

  "load_cases": [
    {
      // Limit down-load through the lug.
      "name": "down_limit",
      "weight": 1.0,
      "point_loads": [
        {
          "name": "lug_bearing_down",
          "force": [0.0, -9000.0],
          "distribution": "total",
          "region": { "annulus": { "center": [0.270, 0.100],
                                   "inner_radius": 0.0075, "radius": 0.0105 } }
        }
      ]
    },
    {
      // Load reversal (negative-g manoeuvre), half the magnitude.
      "name": "up_reversal",
      "weight": 0.5,
      "point_loads": [
        {
          "name": "lug_bearing_up",
          "force": [0.0, 4500.0],
          "distribution": "total",
          "region": { "annulus": { "center": [0.270, 0.100],
                                   "inner_radius": 0.0075, "radius": 0.0105 } }
        }
      ]
    },
    {
      // Lateral (side-load) case.
      "name": "lateral",
      "weight": 0.5,
      "point_loads": [
        {
          "name": "lug_bearing_side",
          "force": [4500.0, 0.0],
          "distribution": "total",
          "region": { "annulus": { "center": [0.270, 0.100],
                                   "inner_radius": 0.0075, "radius": 0.0105 } }
        }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 },
    "equilibrium_tolerance": 1e-6
  },

  "modal": {
    "enabled": true,
    "num_modes": 6,
    "mass_type": "consistent",
    "analyse_optimised_topology": true,
    "compare_mass_matched_baseline": true
  },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.35,
    "simp": {
      "penalty": 3.0,
      "emin_ratio": 1e-9,
      "mass_interpolation": "penalty_matched"
    },
    "filter": {
      "type": "density",
      // 3 cells = 3.75 mm, giving a minimum member width of roughly 7.5 mm in
      // an 8 mm plate.
      "radius_elements": 3.0
    },
    "optimizer": {
      "max_iterations": 600,
      // Two independent stop criteria; either one ends the loop and the
      // summary records which fired plus the final value of both.
      //
      //  * change_tolerance 1e-2 is the classic SIMP/OC criterion. On fine
      //    meshes it is met only intermittently, because thin members migrate
      //    one cell at a time long after the objective has settled.
      //  * objective_tolerance 2e-5 over a 20-iteration window is the backstop
      //    that actually terminates fine-mesh runs. Measured on the cantilever
      //    benchmark, stopping at this point gives a compliance within about
      //    0.1% of an 800-iteration run (see docs/benchmarks.md).
      "change_tolerance": 1e-2,
      "objective_tolerance": 5e-5,
      "objective_window": 20,
      "move_limit": 0.2,
      "damping": 0.5,
      "continuation_steps": 3,
      "penalty_start": 1.5,
      "continuation_iterations": 30,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    },
    "passive_regions": [
      {
        "name": "bolt_holes",
        "type": "void",
        "region": {
          "any_of": [
            { "circle": { "center": [0.030, 0.045], "radius": 0.010 } },
            { "circle": { "center": [0.030, 0.155], "radius": 0.010 } }
          ]
        }
      },
      {
        "name": "bolt_collars",
        "type": "solid",
        "region": {
          "any_of": [
            { "annulus": { "center": [0.030, 0.045],
                           "inner_radius": 0.010, "radius": 0.019 } },
            { "annulus": { "center": [0.030, 0.155],
                           "inner_radius": 0.010, "radius": 0.019 } }
          ]
        }
      },
      {
        "name": "lug_hole",
        "type": "void",
        "region": { "circle": { "center": [0.270, 0.100], "radius": 0.0075 } }
      },
      {
        "name": "lug_collar",
        "type": "solid",
        "region": { "annulus": { "center": [0.270, 0.100],
                                 "inner_radius": 0.0075, "radius": 0.017 } }
      }
    ]
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": true }
}
