{
  // ---------------------------------------------------------------------------
  // Benchmark 2: Messerschmitt-Bolkow-Blohm (MBB) beam.
  //
  // The standard topology-optimization reference problem. Only the left half of
  // a simply supported beam under a central point load is modelled; the left
  // edge carries the symmetry condition u_x = 0 and the bottom-right corner is
  // a vertical roller. The load sits at the top-left corner, which is the beam
  // mid-span in the full structure.
  //
  // Dimensionless settings (E = 1 Pa, thickness = 1 m, F = 1 N, cell size 1 m)
  // are used deliberately so the compliance can be compared directly with the
  // values quoted for this benchmark in the literature. Physical SI units would
  // only rescale the objective.
  // ---------------------------------------------------------------------------
  "name": "mbb_beam",
  "description": "MBB beam half model, 50% volume fraction, dimensionless units",
  "units": "SI, with E = 1 Pa and a 1 m x 1 m x 1 m cell (dimensionless benchmark)",

  "mesh": {
    "type": "structured_quad",
    "nx": 180,
    "ny": 60,
    "lx": 180.0,
    "ly": 60.0
  },

  "material": {
    "name": "unit_material",
    "youngs_modulus": 1.0,
    "poisson_ratio": 0.3,
    "density": 1.0
  },

  "model": {
    "thickness": 1.0,
    "stress_state": "plane_stress"
  },

  "boundary_conditions": [
    {
      "name": "symmetry_plane",
      "fix": ["x"],
      "region": { "box": { "xmax": 0.0 } }
    },
    {
      "name": "roller_support",
      "fix": ["y"],
      "region": { "nearest_node": [180.0, 0.0] }
    }
  ],

  "load_cases": [
    {
      "name": "midspan_load",
      "weight": 1.0,
      "point_loads": [
        {
          "name": "top_left_corner",
          "force": [0.0, -1.0],
          "distribution": "total",
          "region": { "nearest_node": [0.0, 60.0] }
        }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 },
    "equilibrium_tolerance": 1e-6
  },

  "modal": { "enabled": false },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.5,
    "simp": { "penalty": 3.0, "emin_ratio": 1e-9 },
    "filter": {
      "type": "density",
      // 4.5 cells at 180 x 60 is the same physical radius as the customary
      // 1.5 cells at 60 x 20, so the minimum length scale is mesh independent.
      "radius_elements": 4.5
    },
    "optimizer": {
      "max_iterations": 600,
      // Two independent stop criteria; either one ends the loop and the
      // summary records which fired plus the final value of both.
      //
      //  * change_tolerance 1e-2 is the classic SIMP/OC criterion. On fine
      //    meshes it is met only intermittently, because thin members migrate
      //    one cell at a time long after the objective has settled.
      //  * objective_tolerance 2e-5 over a 20-iteration window is the backstop
      //    that actually terminates fine-mesh runs. Measured on the cantilever
      //    benchmark, stopping at this point gives a compliance within about
      //    0.1% of an 800-iteration run (see docs/benchmarks.md).
      "change_tolerance": 1e-2,
      "objective_tolerance": 5e-5,
      "objective_window": 20,
      "move_limit": 0.2,
      "damping": 0.5,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true }
}
