{
  // ---------------------------------------------------------------------------
  // Benchmark 7b: the solid wall bracket with the Heaviside projection.
  //
  // bracket_3d unchanged - mesh, material, supports, loads, volume fraction,
  // filter - except for four settings, which this comment lists so the
  // comparison with bracket_3d stays honest:
  //
  //  * topology.projection: on, beta 1 -> 16, doubled every 40 iterations or
  //    as soon as the design settles at the current beta;
  //  * optimizer: move limit 0.1 (from 0.2) and an objective-stall criterion
  //    of 0.1 % over 10 iterations (from 5e-5 over 20), because with a sharp
  //    projection single interface elements keep flipping while the
  //    compliance is stationary; the iteration cap is 300;
  //  * solver: multigrid CG ("amg_cg") instead of the sparse Cholesky
  //    factorisation. Both solve to a relative residual far below anything
  //    that affects the design (1e-10 here); the change is there so the run
  //    records the per-iteration cost of the multigrid path on the same
  //    problem bracket_3d solves directly.
  //
  // What the comparison measures is the gap between the SIMP model the
  // optimiser evaluates and the thresholded structure it exports: bracket_3d
  // ends with a grey level of 0.34 and a thresholded structure markedly stiffer
  // than its SIMP compliance.
  // ---------------------------------------------------------------------------
  "name": "bracket_3d_projected",
  "description": "Solid wall bracket with the Heaviside projection (beta 1 -> 16), AMG-CG",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_hex",
    "nx": 32,
    "ny": 16,
    "nz": 8,
    "lx": 0.24,
    "ly": 0.12,
    "lz": 0.06
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "model": {
    "stress_state": "three_dimensional",
    "integration": { "stiffness_points": 2, "mass_points": 3, "face_points": 2 }
  },

  "boundary_conditions": [
    {
      "name": "wall_face",
      "fix": ["x", "y", "z"],
      "region": { "box": { "xmax": 0.0 } }
    }
  ],

  "load_cases": [
    {
      "name": "down_limit",
      "weight": 1.0,
      // Resultant spread over the bottom edge of the tip face (all nodes across
      // the width), so the total stays mesh independent.
      "point_loads": [
        {
          "name": "tip_bottom_edge",
          "force": [0.0, -3000.0, 0.0],
          "distribution": "total",
          "region": { "box": { "xmin": 0.24, "ymax": 0.0 } }
        }
      ]
    },
    {
      "name": "lateral",
      "weight": 0.5,
      // Sideways (z) load on the mid-height line of the tip face.
      "point_loads": [
        {
          "name": "tip_mid_line",
          "force": [0.0, 0.0, 1200.0],
          "distribution": "total",
          "region": { "box": { "xmin": 0.24, "ymin": 0.0555, "ymax": 0.0645 } }
        }
      ]
    }
  ],

  "solver": {
    "linear": {
      "type": "amg_cg",
      "iterative_tolerance": 1e-10,
      "residual_tolerance": 1e-8
    },
    "equilibrium_tolerance": 1e-6
  },

  "modal": {
    "enabled": true,
    "num_modes": 6,
    "mass_type": "consistent",
    "tolerance": 1e-10,
    "residual_tolerance": 1e-6
  },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.3,
    "simp": {
      "penalty": 3.0,
      "emin_ratio": 1e-9,
      "mass_interpolation": "penalty_matched"
    },
    "filter": {
      "type": "density",
      "radius_elements": 1.5
    },
    "projection": {
      "enabled": true,
      "eta": 0.5,
      "beta_start": 1.0,
      "beta_max": 16.0,
      "beta_factor": 2.0,
      "beta_interval": 40
    },
    "optimizer": {
      "max_iterations": 300,
      "change_tolerance": 1e-2,
      "objective_tolerance": 1e-3,
      "objective_window": 10,
      "move_limit": 0.1,
      "damping": 0.5,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": true }
}
