{
  // ---------------------------------------------------------------------------
  // Benchmark 6: solid wall bracket (three-dimensional, Hex8).
  //
  // A rectangular block is bonded to a wall over its x = 0 face and carries two
  // load cases at its free end: a downward limit load along the bottom tip edge
  // and a lateral load along the mid-height tip line. The lateral case is what
  // a plane model cannot represent: material has to be arranged through the
  // thickness to carry it, so the optimum is a genuinely three-dimensional
  // frame rather than an extruded 2-D truss.
  //
  // The cell is 7.5 mm (32 x 16 x 8 = 4096 Hex8, 15147 DOFs), which keeps one
  // 3-D factorisation at a few seconds; the filter radius of 1.5 cells and the
  // 30 % volume fraction are the same settings as the 2-D benchmarks.
  //
  // Units are SI throughout: metres, newtons, pascals, kilograms.
  // Material: 7075-T6 aluminium (E = 71.7 GPa, nu = 0.33, rho = 2810 kg/m^3).
  // ---------------------------------------------------------------------------
  "name": "bracket_3d",
  "description": "Solid wall bracket, two load cases, minimum compliance at 30% volume fraction",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_hex",
    "nx": 32,
    "ny": 16,
    "nz": 8,
    "lx": 0.24,
    "ly": 0.12,
    "lz": 0.06
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "model": {
    "stress_state": "three_dimensional",
    "integration": { "stiffness_points": 2, "mass_points": 3, "face_points": 2 }
  },

  "boundary_conditions": [
    {
      "name": "wall_face",
      "fix": ["x", "y", "z"],
      "region": { "box": { "xmax": 0.0 } }
    }
  ],

  "load_cases": [
    {
      "name": "down_limit",
      "weight": 1.0,
      // Resultant spread over the bottom edge of the tip face (all nodes across
      // the width), so the total stays mesh independent.
      "point_loads": [
        {
          "name": "tip_bottom_edge",
          "force": [0.0, -3000.0, 0.0],
          "distribution": "total",
          "region": { "box": { "xmin": 0.24, "ymax": 0.0 } }
        }
      ]
    },
    {
      "name": "lateral",
      "weight": 0.5,
      // Sideways (z) load on the mid-height line of the tip face.
      "point_loads": [
        {
          "name": "tip_mid_line",
          "force": [0.0, 0.0, 1200.0],
          "distribution": "total",
          "region": { "box": { "xmin": 0.24, "ymin": 0.0555, "ymax": 0.0645 } }
        }
      ]
    }
  ],

  "solver": {
    "linear": {
      "type": "simplicial_ldlt",
      "residual_tolerance": 1e-8,
      "pivot_tolerance": 1e-14
    },
    "equilibrium_tolerance": 1e-6
  },

  "modal": {
    "enabled": true,
    "num_modes": 6,
    "mass_type": "consistent",
    "tolerance": 1e-10,
    "residual_tolerance": 1e-6
  },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.3,
    "simp": {
      "penalty": 3.0,
      "emin_ratio": 1e-9,
      "mass_interpolation": "penalty_matched"
    },
    "filter": {
      "type": "density",
      "radius_elements": 1.5
    },
    "optimizer": {
      "max_iterations": 250,
      "change_tolerance": 1e-2,
      "objective_tolerance": 5e-5,
      "objective_window": 20,
      "move_limit": 0.2,
      "damping": 0.5,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": true }
}
