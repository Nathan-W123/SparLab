{
  // ---------------------------------------------------------------------------
  // Benchmark 14b: the solid wall bracket, printed standing on its bottom face.
  //
  // bracket_3d_projected unchanged except for topology.overhang (build
  // direction +y, the plate at y = 0), the optimiser (MMA: with OC the
  // filtered run ended at the 300-iteration cap in a period-2 cycle whose
  // compliance alternated by 0.11 %, just above the 0.1 % stall tolerance)
  // and modal analysis switched off. In
  // three dimensions an element's supports are the element below it and that
  // element's four face neighbours in the layer: a 45-degree overhang limit
  // in both lateral directions on these cubic cells.
  //
  // The comparison run (scripts/run_all_benchmarks.sh) repeats this deck
  // with --no-overhang-filter: the unfiltered design, checked for the same
  // build direction (docs/benchmarks.md, section 14).
  // ---------------------------------------------------------------------------
  "name": "bracket_3d_overhang",
  "description": "Solid wall bracket, projection (beta 1 -> 16), overhang filter (build direction +y), AMG-CG",
  "units": "SI (m, N, Pa, kg)",

  "mesh": {
    "type": "structured_hex",
    "nx": 32,
    "ny": 16,
    "nz": 8,
    "lx": 0.24,
    "ly": 0.12,
    "lz": 0.06
  },

  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71.7e9,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },

  "model": {
    "stress_state": "three_dimensional",
    "integration": { "stiffness_points": 2, "mass_points": 3, "face_points": 2 }
  },

  "boundary_conditions": [
    {
      "name": "wall_face",
      "fix": ["x", "y", "z"],
      "region": { "box": { "xmax": 0.0 } }
    }
  ],

  "load_cases": [
    {
      "name": "down_limit",
      "weight": 1.0,
      // Resultant spread over the bottom edge of the tip face (all nodes across
      // the width), so the total stays mesh independent.
      "point_loads": [
        {
          "name": "tip_bottom_edge",
          "force": [0.0, -3000.0, 0.0],
          "distribution": "total",
          "region": { "box": { "xmin": 0.24, "ymax": 0.0 } }
        }
      ]
    },
    {
      "name": "lateral",
      "weight": 0.5,
      // Sideways (z) load on the mid-height line of the tip face.
      "point_loads": [
        {
          "name": "tip_mid_line",
          "force": [0.0, 0.0, 1200.0],
          "distribution": "total",
          "region": { "box": { "xmin": 0.24, "ymin": 0.0555, "ymax": 0.0645 } }
        }
      ]
    }
  ],

  "solver": {
    "linear": {
      "type": "amg_cg",
      "iterative_tolerance": 1e-10,
      "residual_tolerance": 1e-8
    },
    "equilibrium_tolerance": 1e-6
  },

  "modal": {
    "enabled": false,
    "num_modes": 6,
    "mass_type": "consistent",
    "tolerance": 1e-10,
    "residual_tolerance": 1e-6
  },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.3,
    "simp": {
      "penalty": 3.0,
      "emin_ratio": 1e-9,
      "mass_interpolation": "penalty_matched"
    },
    "filter": {
      "type": "density",
      "radius_elements": 1.5
    },
    "projection": {
      "enabled": true,
      "eta": 0.5,
      "beta_start": 1.0,
      "beta_max": 16.0,
      "beta_factor": 2.0,
      "beta_interval": 40
    },
    "overhang": {
      "filter": true,
      "build_direction": "+y"
    },
    "optimizer": {
      "method": "mma",
      "max_iterations": 300,
      "change_tolerance": 1e-2,
      "objective_tolerance": 1e-3,
      "objective_window": 10,
      "move_limit": 0.1,
      "damping": 0.5,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true, "mode_shapes": false }
}
