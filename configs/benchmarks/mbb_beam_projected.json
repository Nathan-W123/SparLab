{
  // ---------------------------------------------------------------------------
  // Benchmark 7a: the MBB beam with the Heaviside projection.
  //
  // mbb_beam unchanged - mesh, material, supports, load, volume fraction,
  // filter - except for three settings, listed so the comparison with
  // mbb_beam stays honest. They are the settings every projected deck uses
  // (bracket_3d_projected, bracket_3d_large, lug_bracket_2d, engine_mount_3d):
  //
  //  * topology.projection: on, beta 1 -> 32, doubled every 40 iterations or
  //    as soon as the design settles at the current beta;
  //  * optimizer: move limit 0.1 (from 0.2) and an objective-stall criterion
  //    of 0.1 % over 10 iterations (from 5e-5 over 20); the cap is 400.
  //
  // Why the stopping rule changes with the projection: at a large beta single
  // elements on the solid-void interface flip by the whole move limit while
  // the compliance stands still, so the design change never settles, and the
  // compliance wanders inside a band of a few tenths of a percent. The same
  // deck with only the projection switched on (sparlab_topopt --projection)
  // measured exactly that: at its 600-iteration cap the design change was
  // still 0.2 and the compliance had moved within a 0.39 % band over the
  // last 101 iterations, so neither of mbb_beam's criteria could fire. This
  // deck stops after 218 iterations (docs/benchmarks.md, section 7).
  // ---------------------------------------------------------------------------
  "name": "mbb_beam_projected",
  "description": "MBB beam half model, 50% volume fraction, Heaviside projection (beta 1 -> 32)",
  "units": "SI, with E = 1 Pa and a 1 m x 1 m x 1 m cell (dimensionless benchmark)",

  "mesh": {
    "type": "structured_quad",
    "nx": 180,
    "ny": 60,
    "lx": 180.0,
    "ly": 60.0
  },

  "material": {
    "name": "unit_material",
    "youngs_modulus": 1.0,
    "poisson_ratio": 0.3,
    "density": 1.0
  },

  "model": {
    "thickness": 1.0,
    "stress_state": "plane_stress"
  },

  "boundary_conditions": [
    {
      "name": "symmetry_plane",
      "fix": ["x"],
      "region": { "box": { "xmax": 0.0 } }
    },
    {
      "name": "roller_support",
      "fix": ["y"],
      "region": { "nearest_node": [180.0, 0.0] }
    }
  ],

  "load_cases": [
    {
      "name": "midspan_load",
      "weight": 1.0,
      "point_loads": [
        {
          "name": "top_left_corner",
          "force": [0.0, -1.0],
          "distribution": "total",
          "region": { "nearest_node": [0.0, 60.0] }
        }
      ]
    }
  ],

  "solver": {
    "linear": { "type": "simplicial_ldlt", "residual_tolerance": 1e-8 },
    "equilibrium_tolerance": 1e-6
  },

  "modal": { "enabled": false },

  "topology": {
    "enabled": true,
    "volume_fraction": 0.5,
    "simp": { "penalty": 3.0, "emin_ratio": 1e-9 },
    "filter": {
      "type": "density",
      // 4.5 cells at 180 x 60 is the same physical radius as the customary
      // 1.5 cells at 60 x 20, so the minimum length scale is mesh independent.
      "radius_elements": 4.5
    },
    "projection": {
      "enabled": true,
      "eta": 0.5,
      "beta_start": 1.0,
      "beta_max": 32.0,
      "beta_factor": 2.0,
      "beta_interval": 40
    },
    "optimizer": {
      "max_iterations": 400,
      "change_tolerance": 1e-2,
      "objective_tolerance": 1e-3,
      "objective_window": 10,
      "move_limit": 0.1,
      "damping": 0.5,
      "history_stride": 1,
      "interpretation_threshold": 0.5
    }
  },

  "output": { "csv": true, "vtk": true, "density_history": true }
}
