// ---------------------------------------------------------------------------
// Parametric-study variant of configs/benchmarks/aerospace_bracket.json.
//
// Identical physics, geometry, attachment representation and convergence rule;
// only the mesh (120 x 80 instead of 240 x 160), the filter radius in cells
// (1.5 instead of 3.0, so the *physical* radius matches) and the output volume
// differ. The coarse mesh keeps a 41-point sweep affordable; the
// mesh-resolution arm of the study quantifies what that costs.
//
// The optimiser tolerances are deliberately identical to the benchmark decks
// (max_iterations 600, change_tolerance 1e-2, objective_tolerance 5e-5 over a
// 20-iteration window). Every study point therefore stops by the same rule as
// every benchmark, which is what makes compliance comparable across arms.
//
// The study script overrides volume_fraction, penalty, filter radius, load-case
// weights, mesh resolution and Young's modulus from the command line, so this
// deck holds only the shared baseline.
// ---------------------------------------------------------------------------
{
  "name": "aerospace_bracket_study",
  "description": "Coarse-mesh bracket used by the parametric design study (120 x 80)",
  "units": "SI (m, N, Pa, kg)",
  "mesh": {
    "type": "structured_quad",
    "nx": 120,
    "ny": 80,
    "lx": 0.3,
    "ly": 0.2
  },
  "material": {
    "name": "Al 7075-T6",
    "youngs_modulus": 71700000000.0,
    "poisson_ratio": 0.33,
    "density": 2810.0
  },
  "model": {
    "thickness": 0.008,
    "stress_state": "plane_stress",
    "integration": {
      "stiffness_points": 2,
      "mass_points": 3,
      "edge_points": 2
    }
  },
  "boundary_conditions": [
    {
      "name": "bolt_attachments",
      "fix": [
        "x",
        "y"
      ],
      "region": {
        "any_of": [
          {
            "circle": {
              "center": [
                0.03,
                0.045
              ],
              "radius": 0.0105
            }
          },
          {
            "circle": {
              "center": [
                0.03,
                0.155
              ],
              "radius": 0.0105
            }
          }
        ]
      }
    }
  ],
  "load_cases": [
    {
      "name": "down_limit",
      "weight": 1.0,
      "point_loads": [
        {
          "name": "lug_bearing_down",
          "force": [
            0.0,
            -9000.0
          ],
          "distribution": "total",
          "region": {
            "annulus": {
              "center": [
                0.27,
                0.1
              ],
              "inner_radius": 0.0075,
              "radius": 0.0105
            }
          }
        }
      ]
    },
    {
      "name": "up_reversal",
      "weight": 0.5,
      "point_loads": [
        {
          "name": "lug_bearing_up",
          "force": [
            0.0,
            4500.0
          ],
          "distribution": "total",
          "region": {
            "annulus": {
              "center": [
                0.27,
                0.1
              ],
              "inner_radius": 0.0075,
              "radius": 0.0105
            }
          }
        }
      ]
    },
    {
      "name": "lateral",
      "weight": 0.5,
      "point_loads": [
        {
          "name": "lug_bearing_side",
          "force": [
            4500.0,
            0.0
          ],
          "distribution": "total",
          "region": {
            "annulus": {
              "center": [
                0.27,
                0.1
              ],
              "inner_radius": 0.0075,
              "radius": 0.0105
            }
          }
        }
      ]
    }
  ],
  "solver": {
    "linear": {
      "type": "simplicial_ldlt",
      "residual_tolerance": 1e-08
    },
    "equilibrium_tolerance": 1e-06
  },
  "modal": {
    "enabled": false,
    "num_modes": 6,
    "mass_type": "consistent",
    "analyse_optimised_topology": true,
    "compare_mass_matched_baseline": true
  },
  "topology": {
    "enabled": true,
    "volume_fraction": 0.35,
    "simp": {
      "penalty": 3.0,
      "emin_ratio": 1e-09,
      "mass_interpolation": "penalty_matched"
    },
    "filter": {
      "type": "density",
      "radius_elements": 1.5
    },
    "optimizer": {
      "max_iterations": 600,
      "change_tolerance": 1e-2,
      "objective_tolerance": 5e-5,
      "objective_window": 20,
      "move_limit": 0.2,
      "damping": 0.5,
      "continuation_steps": 3,
      "penalty_start": 1.5,
      "continuation_iterations": 30,
      "history_stride": 0,
      "interpretation_threshold": 0.5
    },
    "passive_regions": [
      {
        "name": "bolt_holes",
        "type": "void",
        "region": {
          "any_of": [
            {
              "circle": {
                "center": [
                  0.03,
                  0.045
                ],
                "radius": 0.01
              }
            },
            {
              "circle": {
                "center": [
                  0.03,
                  0.155
                ],
                "radius": 0.01
              }
            }
          ]
        }
      },
      {
        "name": "bolt_collars",
        "type": "solid",
        "region": {
          "any_of": [
            {
              "annulus": {
                "center": [
                  0.03,
                  0.045
                ],
                "inner_radius": 0.01,
                "radius": 0.019
              }
            },
            {
              "annulus": {
                "center": [
                  0.03,
                  0.155
                ],
                "inner_radius": 0.01,
                "radius": 0.019
              }
            }
          ]
        }
      },
      {
        "name": "lug_hole",
        "type": "void",
        "region": {
          "circle": {
            "center": [
              0.27,
              0.1
            ],
            "radius": 0.0075
          }
        }
      },
      {
        "name": "lug_collar",
        "type": "solid",
        "region": {
          "annulus": {
            "center": [
              0.27,
              0.1
            ],
            "inner_radius": 0.0075,
            "radius": 0.017
          }
        }
      }
    ]
  },
  "output": {
    "csv": true,
    "vtk": false,
    "density_history": false,
    "mode_shapes": false
  }
}
